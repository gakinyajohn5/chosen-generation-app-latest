# Copy this file to .env for local development.
# On Render, set these in the dashboard's Environment tab instead — do not commit a real .env.

GEMINI_API_KEY=your_gemini_api_key_here
PORT=3000

# M-Pesa Daraja
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey_here
MPESA_CALLBACK_URL=https://YOUR_RENDER_APP.onrender.com/api/mpesa/callback
MPESA_AMOUNT=20
# sandbox while testing, production only when you're ready to take live payments
MPESA_ENV=sandbox
